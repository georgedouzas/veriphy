theorem sl3_jacobi (x y z : Fin 8 → ℤ) :
    VeriphyCheck.scBracket sl3 x (VeriphyCheck.scBracket sl3 y z) +
      VeriphyCheck.scBracket sl3 y (VeriphyCheck.scBracket sl3 z x) +
      VeriphyCheck.scBracket sl3 z (VeriphyCheck.scBracket sl3 x y) = 0 :=
  VeriphyCheck.jacobi_of_check (by decide +kernel) x y z

theorem sl3_alternating (x : Fin 8 → ℤ) : VeriphyCheck.scBracket sl3 x x = 0 :=
  VeriphyCheck.bracket_self_of_check (by decide +kernel) x

