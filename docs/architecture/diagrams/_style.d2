# Shared classes: the kind of a step, and whether a part is deterministic.
classes: {
  agent: {style: {fill: "#f2f2f2"; stroke: "#8a8a8a"; stroke-dash: 4}}
  evidence: {style: {fill: "#fff4d6"; stroke: "#c99a2e"}}
  check: {style: {fill: "#dff3e3"; stroke: "#3c8d50"; bold: true}}
  derived: {style: {fill: "#e8f1fb"; stroke: "#4a78b5"}}
  deterministic: {style: {fill: "#fafcff"; stroke: "#4a78b5"}}
  open: {style: {fill: "#fafafa"; stroke: "#8a8a8a"; stroke-dash: 4}}
}
