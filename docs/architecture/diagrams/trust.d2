...@_style
direction: right

primitives: "Primitives, by trust class" {
  lean: "lean.check · kernel\n(lean pack)" {class: check}
  oohorn: "oo-horn.check · checker\n(core pack)" {class: check}
  r: "r.run · reproduction\n(reproduction pack)" {class: evidence}
  sage: "sage.* · oracle\n(math pack)" {class: evidence}
  shacl: "shacl.validate · measurement\n(core pack)" {class: derived}
}

levels: "Levels in one order, each granted by one class" {
  grid-columns: 1
  certificate: "certificate · kernel · math"
  leanproof: "lean-proof · kernel · lean"
  kerneltest: "kernel-test · kernel · math"
  robust: "robust · reproduction · reproduction"
  reproduced: "reproduced · reproduction · reproduction"
  oracletest: "oracle-test · oracle · math"
  none: "none · core"
}

primitives.lean -> levels.certificate
primitives.lean -> levels.leanproof
primitives.lean -> levels.kerneltest
primitives.sage -> levels.oracletest
primitives.r -> levels.reproduced
primitives.r -> levels.robust
primitives.oohorn -> levels: "effective levels\nover the graph"
primitives.shacl -> levels: "grants nothing" {style.stroke-dash: 3}
