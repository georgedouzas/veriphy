...@_style
direction: right

inputs: "Declared inputs" {
  class: deterministic
  artifacts: "artifacts\nstatement · script · data"
  scope: "digest scope\nfile · lean-imports · …"
  config: "resolved config\nthe primitive's entry and pin"
  seed: "seed\n(random primitives)"
}

digest: "input digest" {shape: hexagon}
known: "record\nexists?" {shape: diamond}
primitive: "primitive\nlayer 0" {class: deterministic}
record: "record\n.veriphy/runs/<step>/<digest>.json" {shape: cylinder}

inputs -> digest
digest -> known
known -> record: "yes: return it"
known -> primitive: "no: call"
primitive -> record: write
