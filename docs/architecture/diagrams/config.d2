...@_style
direction: right

core: "core defaults" {class: deterministic}
packs: "packs, in listed order" {
  class: deterministic
  math: "math\nLean · Sage · oo-horn · recipes"
  econ: "./packs/econ\nR · levels · conventions"
}
workspace: "veriphy.yaml\n(every key optional)" {shape: page}
merge: "merge\nlater wins, key by key" {shape: diamond}
resolved: "resolved config" {class: derived}
validate: "veriphy config check\npins · seeds · trust rules" {class: check}
records: "every record\ncarries its digest" {shape: cylinder}

core -> merge
packs.math -> merge
packs.econ -> merge
workspace -> merge
merge -> resolved
resolved -> validate
resolved -> records: hashed into
