...@_style
direction: right

defaults: "core defaults" {class: deterministic}
packs: "packs, each after the packs it needs" {
  class: deterministic
  grid-columns: 1
  core: "core\nrecords · claim graph · oo-horn"
  lean: "lean\nLean toolchain"
  math: "math · needs lean\nSageMath · recipes"
  econ: "./packs/econ\nR · levels · conventions"
}
workspace: "veriphy.yaml\n(every key optional)" {shape: page}
merge: "merge\nlater wins, key by key\nnull removes" {shape: diamond}
resolved: "resolved config" {class: derived}
check: "veriphy config check\nschemas · pins · seeds ·\ntrust · one level order" {class: check}

registries: "one registry per layer" {
  class: deterministic
  grid-columns: 1
  p: "primitives"
  st: "steps"
  l: "levels · conventions"
  w: "workflows"
  b: "playbooks"
}

defaults -> merge
packs -> merge
workspace -> merge
merge -> resolved
resolved -> check
resolved -> registries
