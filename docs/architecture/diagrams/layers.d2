...@_style
direction: down

grid: "" {
  grid-rows: 6
  grid-columns: 2
  vertical-gap: 36
  horizontal-gap: 36
  style: {stroke-width: 0; fill: transparent}

  agents: "4 · Agents: write artifacts and choose workflows" {
    class: open
    grid-columns: 4
    prove
    certify
    research
    reproduce
  }
  x4: "a pack adds\nplaybooks and skills" {class: open; shape: page}

  workflows: "3 · Workflows: step sequences as data, the next step from the records" {
    class: deterministic
    grid-columns: 3
    prove: "prove-claim"
    paper: "verify-paper"
    analysis: "reproduce-analysis"
  }
  x3: "a pack adds\nworkflows" {class: open; shape: page}

  claims: "2 · Claims: what the records establish" {
    class: deterministic
    grid-columns: 4
    graph: "claim graph"
    levels: "levels\none order"
    grant: "grant rule\nby trust class"
    report
  }
  x2: "a pack adds\nlevels · conventions" {class: open; shape: page}

  stepper: "1 · Steps: a primitive, hashed inputs, a replayable record" {
    class: deterministic
    grid-columns: 4
    elaborate {class: check}
    meaning {class: evidence}
    certify {class: check}
    reproduce {class: evidence}
  }
  x1: "a pack adds\nstep definitions · digest scopes" {class: open; shape: page}

  primitives: "0 · Primitives: typed, pinned, deterministic; no records, no config" {
    class: deterministic
    grid-columns: 5
    lean: "lean.check\nkernel"
    sage: "sage.sample\noracle"
    oohorn: "oo-horn.check\nchecker"
    r: "r.run\nreproduction"
    more: "…\nany pack" {class: open}
  }
  x0: "a pack adds\nprimitives · tools" {class: open; shape: page}

  packs: "Packs, selected by veriphy.yaml" {
    class: open
    grid-columns: 4
    core: "core\nrecords · claim graph · oo-horn"
    lean: "lean\nLean toolchain · lean-proof"
    math: "math · needs lean\nSageMath · recipes"
    reproduction: "reproduction\nR · reproduced · robust"
  }
  config: "veriphy.yaml\nselects packs,\noverrides any key" {shape: page}
}

