...@_style
direction: down

stack: "Each module imports only the modules below it and the shared ones" {
  style: {stroke-width: 0; fill: transparent}
  grid-columns: 1
  vertical-gap: 24
  agents: "4 · skills/ and the packs' playbooks" {class: open}
  workflows: "3 · veriphy.workflows · next · run" {class: deterministic}
  claims: "2 · veriphy.graph · claims · levels · reasoning · reports" {class: deterministic}
  stepper: "1 · veriphy.steps · the step runner · python -m veriphy <step>" {class: deterministic}
  primitives: "0 · veriphy.primitives · descriptors · contracts · pins · python -m veriphy primitive" {
    class: deterministic
  }
  shared: "shared by every layer" {
    grid-columns: 2
    config: "veriphy.config\nschema · packs · merge · registries" {class: deterministic}
    core: "veriphy.core\nerrors · digests · canonical JSON · record store" {class: deterministic}
  }
  packs: "packs: data in pack.yaml, code in their own modules" {
    class: open
    grid-columns: 4
    core: "veriphy.packs.core\noo-horn · claim graph steps"
    lean: "veriphy.packs.lean\nLean primitives · Lean library"
    math: "veriphy.packs.math\nSage daemon · toolkit ·\nrecipes · translations"
    reproduction: "veriphy.packs.reproduction\nR · example"
  }
}
