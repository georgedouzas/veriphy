...@_style
direction: down

stack: "Each module imports only lower layers and veriphy.core" {
  style: {stroke-width: 0; fill: transparent}
  grid-columns: 1
  vertical-gap: 24
  facade: "veriphy.run(verb, target, **inputs) → Result    ·    veriphy.script (Goal, found, refuted, unknown)" {
    class: open
  }
  agents: "4 · veriphy.agents · playbooks · veriphy layers agents path" {class: open}
  workflows: "3 · veriphy.workflows · next · run" {class: deterministic}
  claims: "2 · veriphy.claims · claim graph · levels · trust · reasoning · reports · veriphy layers claims" {class: deterministic}
  stepper: "1 · veriphy.steps · runner · digest scopes · records · veriphy layers step <verb>" {class: deterministic}
  primitives: "0 · veriphy.primitives · descriptors · contracts · pins · composites · graph · veriphy layers primitive" {
    class: deterministic
  }
  shared: "veriphy.core · errors · digests · canonical JSON · processes · packs and the merge · veriphy config" {
    class: deterministic
  }
  packs: "veriphy.packs.<name>: pack.yaml + the same layer subpackages" {
    class: open
    grid-columns: 3
    core: "core\nthe framework pack: the built-ins"
    math: "math\nlean/ · primitives/lean · primitives/sage\nprimitives/translations · script · steps · agents"
    social: "social_science\nprimitives (analysis runner)\nclaims (check-concepts) · agents"
  }
}
