...@_style
...@legend
direction: right

extract: "extract\nclaims · data · assumptions" {class: agent}
validate: "validate\nshapes" {class: evidence}
reproduce: "reproduce\nR · pinned image ·\ndata hash · seed" {class: evidence}
test: "test\nagreed variations" {class: evidence}
reason: "reason\noo-horn verdict ·\neffective levels · clashes" {class: check}
report: "report\nappendix" {class: derived}
mismatch: "mismatch\nboth estimates recorded" {shape: oval}

extract -> validate -> reproduce
reproduce -> test: "reproduced"
reproduce -> mismatch: differs
test -> reason: "robust or not"
reason -> report
