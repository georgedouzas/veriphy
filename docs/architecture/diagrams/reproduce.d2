...@_style
...@legend
direction: right

extract: "record-claims\nclaims · data · assumptions" {class: agent}
validate: "check-concepts\nconstructs · thesaurus" {class: evidence}
reproduce: "reproduce\nthe authors' Python ·\ndata hash · seed" {class: check}
test: "robustness\ndeclared variations" {class: check}
reason: "reason\noo-horn verdict ·\neffective levels · clashes" {class: check}
report: "appendix" {class: derived}
mismatch: "mismatch\nboth estimates recorded" {shape: oval}

extract -> validate -> reproduce
reproduce -> test: "reproduced"
reproduce -> mismatch: differs
test -> reason: "robust or not"
reason -> report
