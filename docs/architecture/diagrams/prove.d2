...@_style
...@legend
direction: right

formalize: "formalize\nLean statement" {class: agent}
meaning: "meaning\nback-translation ·\nseeded numeric test" {class: evidence}
elaborate: "elaborate\nstatement type-checks" {class: check}
search: "search\nSage script" {class: evidence}
certify: "certify\nkernel · axioms · replay" {class: check}
test: "test\nseeded instances" {class: evidence}
level: "level\nfrom the proof term" {class: check}
report: "report" {class: derived}
suspect: "statement-suspect" {shape: oval}

formalize -> meaning
meaning -> elaborate: agrees
meaning -> suspect: counterexample
elaborate -> search
search -> certify: candidate
certify -> search: "rejected: iterate" {style.stroke-dash: 3}
certify -> level: accepted
search -> test: "no certificate feasible"
test -> level
level -> report
